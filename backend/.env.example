APP_NAME="Make Cars API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production (Render) : LOG_CHANNEL=stderr, LOG_LEVEL=warning — le disque du
# serveur est effacé à chaque redémarrage ; le journal s'affiche dans l'onglet
# « Logs » du tableau de bord Render.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Journal des requêtes lentes (route, durée, nombre de requêtes SQL) : actif
# par défaut en production seulement ; LOG_SLOW_REQUESTS=true pour mesurer
# ailleurs. Seuil en millisecondes.
# LOG_SLOW_REQUESTS=
SLOW_REQUEST_THRESHOLD_MS=1000

# PostgreSQL Supabase — Session Pooler (Project Settings > Database dans le dashboard Supabase).
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.aowpgpeabffpqneflzas
DB_PASSWORD=

# Frontend web (SPA Vue 3 + TypeScript) autorisé à appeler l'API — liste séparée par virgules.
# En production : l'adresse réelle du site, en https (même valeur que FRONTEND_URL en général).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Proxies de confiance (config/trustedproxy.php) — vide en développement.
# En production derrière un proxy/répartiteur de charge : les adresses ou plages
# de ses proxies, documentées par l'hébergeur, séparées par des virgules. Sans
# cela, tous les visiteurs ont l'IP du proxy et les limites par IP bloquent tout le monde.
TRUSTED_PROXIES=

# Pilotes cache / sessions / file d'attente — en développement, valeurs
# historiques (base de données). En production (DEPLOIEMENT.md), aucune
# requête vers la base pour eux, chacune coûtant un aller-retour vers Supabase :
# - CACHE_STORE=file : cache et limites de débit sur le disque du serveur. Une
#   seule instance, donc compteurs cohérents ; perdus à un redémarrage (sans
#   gravité : une minute de limite remise à zéro, certificats Google relus).
#   Avec database, chaque requête limitée (connexion, /api/health…) faisait
#   jusqu'à 12 requêtes SQL de plus.
# - SESSION_DRIVER=array : l'API s'authentifie par jeton Sanctum et ne sert
#   aucune page ; aucune route n'utilise de session.
# - QUEUE_CONNECTION=sync : aucune tâche mise en file (les emails partent
#   après la réponse, sans file) et aucun worker sur l'offre gratuite.
# - SANCTUM_TRACK_LAST_USED_AT=false : plus d'écriture de la date de dernière
#   utilisation du jeton à chaque requête authentifiée (jamais lue).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

SANCTUM_TRACK_LAST_USED_AT=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" par défaut (aucun email réellement envoyé, juste écrit dans les logs) :
# toujours en développement.
# En dev, "smtp" avec un sandbox Mailtrap (Email Testing > SMTP Settings) reste
# possible pour recevoir réellement les emails sans risquer d'en envoyer à de
# vrais clients.
# Production sur Render (SMTP sortant bloqué sur l'offre gratuite) :
# MAIL_MAILER=resend et RESEND_API_KEY (clé API Resend), expéditeur
# MAIL_FROM_ADDRESS sur un domaine vérifié chez Resend (DEPLOIEMENT.md).
# Sur un hébergement qui autorise le SMTP : MAIL_MAILER=smtp et les variables
# MAIL_HOST/PORT/USERNAME/PASSWORD — aucun changement de code.
# Les emails partent après la réponse HTTP (App\Support\DeferredMail).
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stockage des fichiers. En développement : disques locaux (valeurs ci-dessous).
# En production sur Render (disque effacé à chaque redémarrage) : Supabase
# Storage, API compatible S3 (DEPLOIEMENT.md, étape 2) —
#   KYC_DOCUMENTS_DISK=supabase, PRIVATE_MEDIA_DISK=supabase (bucket PRIVÉ),
#   PUBLIC_MEDIA_DISK=supabase_public (bucket PUBLIC).
# Clés : Supabase > Project Settings > Storage > S3 Connection / S3 Access Keys.
#   SUPABASE_STORAGE_ENDPOINT=https://<projet>.storage.supabase.co/storage/v1/s3
#   SUPABASE_PUBLIC_URL=https://<projet>.supabase.co/storage/v1/object/public/<bucket public>

# Justificatifs d'inscription (registre de commerce, CIP).
KYC_DOCUMENTS_DISK=local
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=

# Médias publics (photos de garage, de produits...) affichés dans l'app mobile.
PUBLIC_MEDIA_DISK=public
SUPABASE_PUBLIC_BUCKET=
SUPABASE_PUBLIC_URL=

# Contenu privé propre à une relation précise : pièces jointes du chat et des
# réclamations, PDF de devis/facture (même bucket privé que les justificatifs).
PRIVATE_MEDIA_DISK=local

# Connexion Google (automobiliste uniquement — CLAUDE.md §5 ajout v0.5).
# Client ID OAuth 2.0 de type "Web" créé dans Google Cloud Console : sert
# d'audience pour vérifier les ID tokens envoyés par l'app Flutter.
GOOGLE_CLIENT_ID=

# Recherche géolocalisée (CLAUDE.md §5, ajout v0.13). Fuseau horaire métier
# pour le calcul "ouvert maintenant" (Bénin uniquement en V1) et bornes du
# rayon de recherche en kilomètres.
GEO_BUSINESS_TIMEZONE=Africa/Porto-Novo
GEO_DEFAULT_SEARCH_RADIUS_KM=15
GEO_MAX_SEARCH_RADIUS_KM=100

# Notifications push (CLAUDE.md §5, ajout v0.12). Absente par défaut : le
# service fonctionne alors en mode simulation (notifications créées en base,
# jamais réellement envoyées, aucune erreur bloquante — même approche que le
# paiement manuel V1). Clé serveur de l'API FCM (Firebase Console > Project
# Settings > Cloud Messaging) une fois le projet Firebase créé.
FCM_SERVER_KEY=
