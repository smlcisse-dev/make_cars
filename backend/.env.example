APP_NAME="Make Cars API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Supabase — Session Pooler (Project Settings > Database dans le dashboard Supabase).
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.aowpgpeabffpqneflzas
DB_PASSWORD=

# Frontend web (SPA Vue 3 + TypeScript) autorisé à appeler l'API — liste séparée par virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" par défaut (aucun email réellement envoyé, juste écrit dans les logs).
# En dev, passer à "smtp" avec un sandbox Mailtrap (Email Testing > SMTP Settings
# dans le dashboard Mailtrap) pour recevoir réellement les emails de décision de
# devis (CLAUDE.md §5, ajout v0.9) sans risquer d'en envoyer à de vrais clients.
# En prod, changer uniquement ces variables vers un vrai fournisseur SMTP
# (Brevo, SES, Mailtrap live...) — aucun changement de code nécessaire.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Justificatifs d'inscription (registre de commerce, photos du local).
# "local" par défaut ; passer à "supabase" une fois les identifiants ci-dessous renseignés.
KYC_DOCUMENTS_DISK=local
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=

# Médias publics (photos de garage, de produits...) affichés dans l'app mobile.
# "public" par défaut ; passer à "supabase_public" une fois le bucket public créé.
PUBLIC_MEDIA_DISK=public
SUPABASE_PUBLIC_BUCKET=
SUPABASE_PUBLIC_URL=

# Contenu privé propre à une relation précise : pièces jointes du chat, PDF de
# devis/facture. "local" par défaut ; passer à "supabase" une fois configuré.
PRIVATE_MEDIA_DISK=local

# Connexion Google (automobiliste uniquement — CLAUDE.md §5 ajout v0.5).
# Client ID OAuth 2.0 de type "Web" créé dans Google Cloud Console : sert
# d'audience pour vérifier les ID tokens envoyés par l'app Flutter.
GOOGLE_CLIENT_ID=

# Recherche géolocalisée (CLAUDE.md §5, ajout v0.13). Fuseau horaire métier
# pour le calcul "ouvert maintenant" (Bénin uniquement en V1) et bornes du
# rayon de recherche en kilomètres.
GEO_BUSINESS_TIMEZONE=Africa/Porto-Novo
GEO_DEFAULT_SEARCH_RADIUS_KM=15
GEO_MAX_SEARCH_RADIUS_KM=100

# Notifications push (CLAUDE.md §5, ajout v0.12). Absente par défaut : le
# service fonctionne alors en mode simulation (notifications créées en base,
# jamais réellement envoyées, aucune erreur bloquante — même approche que le
# paiement manuel V1). Clé serveur de l'API FCM (Firebase Console > Project
# Settings > Cloud Messaging) une fois le projet Firebase créé.
FCM_SERVER_KEY=
