# OS / editor
.DS_Store
Thumbs.db
.idea/
# Racine du dépôt uniquement (slash de tête) : un `.vscode/` sans slash
# ignorerait aussi frontend-web/.vscode/, alors que ce sous-projet gère déjà
# le sien via son propre .gitignore (garde extensions.json, ignore le reste).
/.vscode/

# Claude Code local session settings (machine-specific)
.claude/settings.local.json

# Frontend web (Vue 3 + TypeScript)
frontend-web/node_modules/
frontend-web/dist/
frontend-web/.env
frontend-web/.env.local

# Mobile (Flutter) — standard build/generated artifacts, ignored in advance.
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/*.iml
