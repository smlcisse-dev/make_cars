# URL de base de l'API Laravel (backend/), sans slash final. `127.0.0.1`
# plutôt que `localhost` : `php artisan serve` n'écoute qu'en IPv4, et sur
# certaines machines/conteneurs "localhost" résout en IPv6 (::1) où rien
# n'écoute — la requête échoue ou traîne au lieu d'aboutir immédiatement.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
